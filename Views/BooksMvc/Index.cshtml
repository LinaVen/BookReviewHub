@model List<BookReviewHub.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<h2 class="my-3">📚 Book List</h2>

<div class="row">
    @foreach (var book in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm p-3 h-100">
                <h5>@book.Title</h5>
                <p><strong>Author:</strong> @book.Author</p>
                <p><strong>Genre:</strong> @book.Genre?.Name</p>
                <a href="@Url.Action("Details", "BooksMvc", new { id = book.Id })" class="btn btn-primary">View Details</a>
            </div>
        </div>
    }
</div>
