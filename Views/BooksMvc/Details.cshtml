@model BookReviewHub.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<h2 class="mb-3">@Model.Title</h2>
<p><strong>Author:</strong> @Model.Author</p>
<p><strong>Genre:</strong> @Model.Genre?.Name</p>

<hr />
<h4>📝 Reviews</h4>

@if (Model.Reviews == null || !Model.Reviews.Any())
{
    <p>No reviews for this book yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var review in Model.Reviews)
        {
            <li class="list-group-item">
                <strong>@review.ReviewerName</strong> - ⭐ @review.Rating/5
                <p>@review.Comment</p>
            </li>
        }
    </ul>
}

<hr />
<h4 class="mt-4">➕ Leave a Review</h4>

<form method="post" asp-action="AddReview">
    <input type="hidden" name="BookId" value="@Model.Id" />

    <div class="mb-2">
        <label>Your Name</label>
        <input name="ReviewerName" class="form-control" required />
    </div>
    <div class="mb-2">
        <label>Rating (1–5)</label>
        <input type="number" name="Rating" class="form-control" min="1" max="5" required />
    </div>
    <div class="mb-2">
        <label>Comment</label>
        <textarea name="Comment" class="form-control" required></textarea>
    </div>
    <button type="submit" class="btn btn-success">Submit Review</button>
</form>
